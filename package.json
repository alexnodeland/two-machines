{
  "name": "two-machines",
  "description": "A guide to tape-delay looping, taught by letting you play it in the page",
  "version": "0.0.0",
  "private": true,
  "author": "Alex Nodeland",
  "license": "MIT",
  "homepage": "https://alexnodeland.github.io/two-machines/",
  "keywords": [
    "frippertronics",
    "tape-delay",
    "webaudio",
    "audioworklet",
    "wasm",
    "dsp",
    "music-education",
    "gatsby"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alexnodeland/two-machines"
  },
  "scripts": {
    "develop": "bun scripts/generate-sources.mjs && bash scripts/prebuild-quiver.sh && gatsby develop",
    "build": "bun scripts/generate-sources.mjs && bash scripts/prebuild-quiver.sh && gatsby build --prefix-paths",
    "serve": "gatsby serve --prefix-paths",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke": "bash scripts/smoke.sh",
    "prepare": "husky",
    "prebuild:quiver": "bash scripts/prebuild-quiver.sh",
    "generate:sources": "bun scripts/generate-sources.mjs"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "gatsby",
    "gatsby-cli",
    "gatsby-telemetry",
    "lmdb",
    "msgpackr-extract",
    "sharp"
  ],
  "dependencies": {
    "@mdx-js/react": "^2.3.0",
    "@quiver-dsp/wasm": "0.3.3",
    "gatsby": "^5.14.0",
    "gatsby-plugin-manifest": "^5.14.0",
    "gatsby-plugin-mdx": "^5.14.0",
    "gatsby-source-filesystem": "^5.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "js-yaml": "^5.2.3",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
